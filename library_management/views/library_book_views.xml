<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_library_book_tree" model="ir.ui.view">
        <field name="name">library.book.tree</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'lost'" decoration-warning="state == 'borrowed'" decoration-success="state == 'available'">
                <field name="name"/>
                <field name="author"/>
                <field name="isbn"/>
                <field name="state" widget="badge"/>
                <field name="borrower_id"/>
                <field name="borrow_date"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <header>
                    <button name="action_borrow" string="Issue Book" type="object" class="btn-primary" invisible="state != 'available'"/>
                    <button name="action_return" string="Return Book" type="object" class="btn-secondary" invisible="state != 'borrowed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,borrowed,lost"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Clean Code"/></h1>
                    </div>
                    <group>
                        <group name="meta_info" string="Book Details">
                            <field name="author"/>
                            <field name="isbn"/>
                            <field name="published_date"/>
                            <field name="pages"/>
                        </group>
                        <group name="issue_info" string="Borrowing Information">
                            <field name="borrower_id" readonly="state == 'borrowed'"/>
                            <field name="borrow_date" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View (Filters & Group By) -->
    <record id="view_library_book_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search string="Search Books">
                <field name="name" string="Book Title"/>
                <field name="author"/>
                <field name="borrower_id"/>
                <separator/>
                <filter string="Available" name="filter_available" domain="[('state', '=', 'available')]"/>
                <filter string="Borrowed" name="filter_borrowed" domain="[('state', '=', 'borrowed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Author" name="group_author" context="{'group_by': 'author'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_library_book_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first book in the catalog!</p>
        </field>
    </record>
</odoo>
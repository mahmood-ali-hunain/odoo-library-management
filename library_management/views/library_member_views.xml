<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Member Tree View -->
    <record id="view_library_member_tree" model="ir.ui.view">
        <field name="name">library.member.tree</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <tree>
                <field name="member_code"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="borrowed_books_count"/>
                <field name="join_date"/>
            </tree>
        </field>
    </record>

    <!-- Member Form View -->
    <record id="view_library_member_form" model="ir.ui.view">
        <field name="name">library.member.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form string="Library Member">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Member Full Name"/></h1>
                        <h3><field name="member_code" placeholder="Member Code"/></h3>
                    </div>
                    <group>
                        <group string="Contact Details">
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group string="Membership Standing">
                            <field name="join_date"/>
                            <field name="active"/>
                            <field name="borrowed_books_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Currently Borrowed Books" name="borrowed_books">
                            <field name="borrowed_book_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="author"/>
                                    <field name="borrow_date"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Member Action Window -->
    <record id="action_library_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>